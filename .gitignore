# Local Codex and runtime state
.agents/
.codex/
.local-runtime-logs/
.pytest-tmp/
.monorepo-staging/
.nested-repo-backups/
__pycache__/
*.py[cod]
collie-sites-preview/
website/

# Local agent worktrees and security-scan scratch state
.site-release-worktree/
.tmp-sites-security-release/
.public-source-worktree/
.public-product-repo/
.public-website-repo/
.tmp/

# Local test and coverage state
.pytest_cache/
.pytest-*/
collie-core/.pytest-final-*/
collie-core/.tmp-pytest-audit/
.coverage
coverage/

# Generic dependency, database, and runtime output
# No trailing slash: matches real directories AND symlinked node_modules
# (worktrees commonly symlink node_modules to the main checkout; the release
# provenance gate requires a clean tree and would otherwise refuse to build).
node_modules
**/node_modules/
dist/
out/
.electron-bundle/
*.log
*.db
*.sqlite
*.sqlite3

# Local environment files; retain explicit, documented examples
.env
.env.*
!.env.example
!.env.*.example

# Reproducible package and staging output (never release source)
collie-core/build/
collie-core/dist/
collie-ui/.electron-bundle/
collie-ui/dist/
collie-ui/out/
*.egg-info/
*.tmp

# Generated build and visual QA artifacts
*.tsbuildinfo
collie-ui/screenshots/

# Private company material and reference repositories stay outside the public product repository
company/
source code competitors/
