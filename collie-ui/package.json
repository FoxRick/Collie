    "provenance:write": "node scripts/build-provenance.cjs write",
    "provenance": "node scripts/build-provenance.cjs print",
    "provenance:verify": "node scripts/artifact-provenance.cjs verify",
    "artifact-provenance:write": "node scripts/artifact-provenance.cjs write",
    "dist": "node scripts/package.cjs",
